# Dependências — nunca copiar para a imagem (** cobre todas as subpastas)
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo

# Git
.git
.gitignore

# Variáveis de ambiente — vêm em runtime, nunca baked na imagem
.env
.env.*
!.env.example

# Artefatos de build
dist/
build/
coverage/
.next/

# Expo
.expo/
apps/mobile/.expo/

# Logs
*.log
npm-debug.log*
bun-debug.log*

# Docs — só a base científica entra na imagem (injetada no system prompt do Claude,
# lida em runtime por apps/api/src/claude/principios.ts). O resto de docs/ fica de fora.
docs/*
!docs/principios_treino.md

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# uv cache
.uv/
