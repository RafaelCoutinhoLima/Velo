{
  "name": "fitsync-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "3.2.2",
    "husky": "9.1.7",
    "vitest": "3.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.8.12",
    "postcss": ">=8.5.10",
    "vite": ">=6.5.0",
    "esbuild": ">=0.25.0"
  },
  "patchedDependencies": {
    "@react-navigation/native-stack@7.14.14": "patches/@react-navigation%2Fnative-stack@7.14.14.patch",
    "react-native-screens@4.24.0": "patches/react-native-screens@4.24.0.patch"
  }
}
