{
  "name": "fitsync-ai",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "check": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "9.1.7",
    "vitest": "3.2.2",
    "@vitest/coverage-v8": "3.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.8.12",
    "postcss": ">=8.5.10",
    "vite": ">=6.5.0",
    "esbuild": ">=0.25.0"
  }
}
