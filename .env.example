# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Custo por milhão de tokens (default = Sonnet 4.6). Atualizar ao migrar de modelo.
CLAUDE_COST_INPUT_PER_MTOK=3
CLAUDE_COST_OUTPUT_PER_MTOK=15

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...                        # apenas no mobile (EXPO_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SOMENTE backend (nunca no mobile!)
SUPABASE_VAULT_KEY_NAME=garmin_tokens

# ─── Garmin sidecar ──────────────────────────────────────────────────────────
GARMIN_SIDECAR_URL=http://garmin-sidecar.railway.internal:8001
# Segredo compartilhado API↔sidecar (mesmo valor nos dois serviços). O sidecar
# rejeita chamadas sem ele. Se vazio, roda em modo dev (aceita sem segredo).
SIDECAR_SECRET=troque-por-um-segredo-forte

# ─── Segurança da API ────────────────────────────────────────────────────────
# Segredo do cron de lembretes (header x-cron-secret em POST /push/rpe-reminders).
# Sem ele, o endpoint rejeita todas as chamadas (401).
CRON_SECRET=troque-por-um-segredo-forte
# Origens permitidas no CORS em produção (lista separada por vírgula). Vazio em
# dev libera qualquer origem (mas credentials fica desligado — auth é Bearer).
CORS_ORIGINS=https://app.velo.run,https://velo.run

# ─── Expo (prefixo EXPO_PUBLIC_ vai para o bundle — nunca colocar segredos) ──
EXPO_PUBLIC_API_URL=https://api.fitsync.app
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Cloudflare R2 (backups pg_dump) ─────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=fitsync-backups

# ─── Resend (emails LGPD) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
PORT=3000
