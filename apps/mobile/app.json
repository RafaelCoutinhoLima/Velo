{
  "expo": {
    "name": "Velo",
    "slug": "fitsync-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitsync",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f8fd",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f8fd"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fitsync.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.fitsync.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2a5ea7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2a5ea7"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
