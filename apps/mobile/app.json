{
  "expo": {
    "name": "FitSync AI",
    "slug": "fitsync-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitsync",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f8fafc",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.fitsync.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.fitsync.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1e40af"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
